  36:Application/wirelessrx.c **** 
  37:Application/wirelessrx.c **** void QITask()
  38:Application/wirelessrx.c **** {
  39:Application/wirelessrx.c ****     static uint8_t count_connected = 0;
  40:Application/wirelessrx.c ****     static uint8_t count_connecting = 0;
  41:Application/wirelessrx.c **** 
  42:Application/wirelessrx.c ****     switch(RxStatus)
  43:Application/wirelessrx.c ****     {
  44:Application/wirelessrx.c ****     case RxStatus_Connecting:
  45:Application/wirelessrx.c ****         SwitchHighOrLowPower(SOF[count_connecting%8]);
  46:Application/wirelessrx.c ****         count_connected = 0;
  47:Application/wirelessrx.c ****         count_connecting++;
  48:Application/wirelessrx.c ****         break;
  49:Application/wirelessrx.c ****     case RxStatus_Connected:
  50:Application/wirelessrx.c ****         // 0.5ms
  51:Application/wirelessrx.c ****         static uint8_t data = 0;
  52:Application/wirelessrx.c **** 
  53:Application/wirelessrx.c ****         if(count_connected < 8)
  54:Application/wirelessrx.c ****         {
  55:Application/wirelessrx.c ****             SwitchHighOrLowPower(SOF[count_connected]);
  56:Application/wirelessrx.c ****             data =  (uint8_t)VIn_f;
  57:Application/wirelessrx.c ****         }
  58:Application/wirelessrx.c ****         else if(count_connected < 16)
  59:Application/wirelessrx.c ****         {
  60:Application/wirelessrx.c ****             DOF[count_connected - 8] = (data >> (15 - count_connected)) & 0x01;
  61:Application/wirelessrx.c ****             SwitchHighOrLowPower(DOF[count_connected - 8]);
  62:Application/wirelessrx.c ****         }
  63:Application/wirelessrx.c ****         else if(count_connected < 200)
  64:Application/wirelessrx.c ****         {
  65:Application/wirelessrx.c ****             HighPower();
  66:Application/wirelessrx.c ****         }
  67:Application/wirelessrx.c ****         else
  68:Application/wirelessrx.c ****         {
  69:Application/wirelessrx.c ****             count_connected = 0;
  70:Application/wirelessrx.c ****         }
  71:Application/wirelessrx.c ****         count_connected++;
  72:Application/wirelessrx.c ****         count_connecting = 0;
  73:Application/wirelessrx.c ****         break;
  74:Application/wirelessrx.c ****     case RxStatus_Disconnected:
  75:Application/wirelessrx.c ****         HighPower();
  76:Application/wirelessrx.c ****         break;
  77:Application/wirelessrx.c ****     }
  78:Application/wirelessrx.c ****     
  79:Application/wirelessrx.c **** }
