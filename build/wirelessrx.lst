  35:Application/wirelessrx.c **** void QITask()
  36:Application/wirelessrx.c **** {
  37:Application/wirelessrx.c ****     switch(RxStatus)
  38:Application/wirelessrx.c ****     {
  39:Application/wirelessrx.c ****     case RxStatus_Connecting:
  40:Application/wirelessrx.c ****         // 0.5ms
  41:Application/wirelessrx.c ****         static uint8_t count = 0;
  42:Application/wirelessrx.c ****         static uint8_t data = 0;
  43:Application/wirelessrx.c **** 
  44:Application/wirelessrx.c ****         if(count < 8)
  45:Application/wirelessrx.c ****         {
  46:Application/wirelessrx.c ****             SwitchHighOrLowPower(SOF[count]);
  47:Application/wirelessrx.c ****             data =  (uint8_t)VIn_f;
  48:Application/wirelessrx.c ****         }
  49:Application/wirelessrx.c ****         else if(count < 16)
  50:Application/wirelessrx.c ****         {
  51:Application/wirelessrx.c ****             DOF[count - 8] = (data >> (15 - count)) & 0x01;
  52:Application/wirelessrx.c ****             SwitchHighOrLowPower(DOF[count - 8]);
  53:Application/wirelessrx.c ****         }
  54:Application/wirelessrx.c ****         else if(count < 200)
  55:Application/wirelessrx.c ****         {
  56:Application/wirelessrx.c ****             HighPower();
  57:Application/wirelessrx.c ****         }
  58:Application/wirelessrx.c ****         else
  59:Application/wirelessrx.c ****         {
  60:Application/wirelessrx.c ****             count = 0;
  61:Application/wirelessrx.c ****         }
  62:Application/wirelessrx.c ****         count++;
  63:Application/wirelessrx.c ****         break;
  64:Application/wirelessrx.c ****     case RxStatus_Disconnected:
  65:Application/wirelessrx.c ****         HighPower();
  66:Application/wirelessrx.c ****         break;
  67:Application/wirelessrx.c ****     }
  68:Application/wirelessrx.c ****     
  69:Application/wirelessrx.c **** }
